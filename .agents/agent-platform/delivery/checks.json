  "checks": [
    {
      "id": "frontend-install",
      "gate": "G-BASE",
      "cwd": "web",
      "argv": [
        "bun",
        "install",
        "--frozen-lockfile"
      ],
      "timeout_seconds": 600,
      "kind": "command",
      "required_files": [
        "web/package.json",
        "web/bun.lock"
      ]
    },
    {
      "id": "frontend-typecheck",
      "gate": "G-BASE",
      "cwd": "web",
      "argv": [
        "bun",
        "run",
        "typecheck"
      ],
      "timeout_seconds": 180,
      "kind": "command",
      "required_files": [
        "web/package.json",
        "web/tsconfig.json"
      ]
    },
    {
      "id": "frontend-build",
      "gate": "G-BASE",
      "cwd": "web",
      "argv": [
        "bun",
        "run",
        "build"
      ],
      "timeout_seconds": 300,
      "kind": "command",
      "required_files": [
        "web/package.json",
        "web/rsbuild.config.ts",
        "web/src/main.tsx",
        "web/index.html"
      ]
    },
    {
      "id": "root-build",
      "gate": "G-BASE",
      "cwd": ".",
      "argv": [
        "go",
        "build",
        "-mod=readonly",
        "./..."
      ],
      "timeout_seconds": 600,
      "kind": "command",
      "required_files": [
        "go.mod",
        "go.sum"
      ],
      "env": {
        "GOWORK": "off"
      }
    },
    {
      "id": "root-vet",
      "gate": "G-BASE",
      "cwd": ".",

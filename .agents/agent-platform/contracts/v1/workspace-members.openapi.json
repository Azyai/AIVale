        "requestBody": {
          "required": true,
          "description": "Only application/json with optional charset=utf-8, identity content encoding, and one complete object with unique exact keys. Max 1 MiB.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./workspace-members.schema.json#/$defs/putRequest"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWorkspaceMember",
        "x-api-id": "API-008",
        "summary": "Revoke an explicit workspace grant",
        "description": "Requires live member:manage. The target must be an enabled current user in the same Team. The Team owner is immutable; an explicit admin cannot revoke another admin but may revoke themself if another effective admin remains. An absent or already blocked grant is an authorized no-op. DELETE applies to the grant current at execution and does not accept a query or request body.",
        "responses": {
          "200": {
            "description": "Revoked result for both actual transition and no-op.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {

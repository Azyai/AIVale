          "200": {
            "description": "Authorized page of explicit grants.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/listResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed workspace ID, query encoding or pagination, duplicate parameter or unknown parameter.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid live dashboard Bearer session (cookies, PAT and model keys are not accepted).",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Visible workspace but insufficient current authority, including an owner target or an unauthorized admin change.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Workspace is absent, archived or invisible; write target is not an enabled current user of this Team.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"
                }
              }

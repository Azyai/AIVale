    "/api/agent-platform/workspaces/{workspace_id}/members/{user_id}": {
      "parameters": [
        {
          "name": "workspace_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./workspace-members.schema.json#/$defs/id"
          },
          "description": "Canonical workspace ID."
        },
        {
          "name": "user_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./workspace-members.schema.json#/$defs/id"
          },
          "description": "Canonical user ID; identity and Team scope are resolved by the server."
        }
      ],
      "put": {
        "operationId": "putWorkspaceMember",
        "x-api-id": "API-007",
        "summary": "Add or update an explicit workspace grant",
        "description": "Requires live member:manage. The target must be an enabled current user in the same Team. The Team owner is immutable; only the valid implicit owner may grant admin or change another existing admin. An explicit admin may demote themself if another effective admin remains. An exact revision plus the same active role succeeds as a no-op. Use the current blocked revision to regrant; zero never replaces an existing row. No query is accepted. The revision is the concurrency boundary; no Idempotency-Key is required.",
        "responses": {
          "200": {
            "description": "Current active explicit grant after the write or no-op.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/putResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed ID, any query, invalid content type or encoding, malformed JSON, unsupported fields, invalid role or revision.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"

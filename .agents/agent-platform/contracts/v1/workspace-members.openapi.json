  "components": {
    "securitySchemes": {
      "DashboardSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Existing dashboard access JWT backed by a live session; not a PAT or model key."
      }
    },
    "headers": {
      "CacheControl": {
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "RequestId": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": "Server-owned request ID, equal to response request_id."

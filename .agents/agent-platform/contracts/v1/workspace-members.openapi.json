              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Platform feature is disabled.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workspace-members.schema.json#/$defs/errorResponse"
                }
              }

          "409": {
            "description": "Revision conflict (AG_DRAFT_REVISION_CONFLICT) or demotion would remove the last effective admin (AG_RESOURCE_IN_USE).",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "X-Oneapi-Request-Id": {
                "$ref": "#/components/headers/RequestId"

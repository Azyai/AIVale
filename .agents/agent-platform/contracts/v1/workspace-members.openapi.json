      "get": {
        "operationId": "listWorkspaceMembers",
        "x-api-id": "API-006",
        "summary": "List explicit workspace grants",
        "description": "Requires live member:manage on an active or suspended workspace. The list contains explicit active or blocked grants for current enabled same-Team users only, sorted by created_at descending then internal member ID descending. No synthetic owner row is added. Only page and page_size are accepted.",

{
  "openapi": "3.1.0",
  "info": {
    "title": "AIVale workspace members API",
    "version": "1.0.0",
    "description": "P01-T05 session-only workspace member management; no Team enrollment, PAT access, or runtime authorization grant."
  },
  "security": [
    {
      "DashboardSession": []
    }
  ],
  "paths": {
    "/api/agent-platform/workspaces/{workspace_id}/members": {
      "parameters": [
        {
          "name": "workspace_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "./workspace-members.schema.json#/$defs/id"

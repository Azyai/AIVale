        "operationId": "createAgentWorkspace",
        "summary": "Create a workspace as current Team owner",
        "description": "Requires current live double-fact Team ownership. Server chooses Team/actor/default policy and creates an explicit initial admin in one transaction. Omitted slug is generated once; names may repeat, slugs remain reserved including after archive. Same-key replay returns original immutable receipt after current authorization. All query parameters and even an empty query marker are rejected. Body is one strict UTF-8 JSON object <=1 MiB, application/json with optional UTF-8 charset; Content-Encoding absent/empty/identity. Unknown/duplicate decoded fields, null, invalid Unicode and trailing documents are rejected.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]{16,128}$"
            },
            "description": "Exactly one visible ASCII value. No whitespace trimming. Persisted only as a hash. Reuse the same key for a retry; different normalized input under the same current scope returns 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./workspace-writes.schema.json#/$defs/createRequest"
              }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aivale:agent-platform:workspace-create-eligibility:1.0.0",
  "title": "AIVale workspace creation eligibility 1.0.0",
  "description": "P01-T08c reads the current dashboard session's live Team owner eligibility. This result does not authorize creation.",
  "$defs": {
    "teamId": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "not": { "pattern": "[^0-9]" },
      "description": "Canonical positive signed-int64 decimal string. No leading zeroes, sign, or whitespace."
    },
    "eligibilityData": {
      "type": "object",
      "properties": {
        "can_create": { "type": "boolean" },
        "team_id": { "type": ["string", "null"] }
      },
      "required": ["can_create", "team_id"],
      "additionalProperties": false,
      "if": { "properties": { "can_create": { "const": true } } },
      "then": { "properties": { "team_id": { "$ref": "#/$defs/teamId" } } },
      "else": { "properties": { "team_id": { "const": null } } }
    },
    "eligibilityResponse": {
      "type": "object",
      "properties": {
        "success": { "const": true },
        "code": { "const": "OK" },
        "message": { "const": "" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "data": { "$ref": "#/$defs/eligibilityData" }
      },
      "required": ["success", "code", "message", "request_id", "data"],
      "additionalProperties": false
    },
    "errorResponse": {
      "$ref": "urn:aivale:agent-platform:core:1.1.0#/$defs/errorResponse"
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/eligibilityResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ]
}

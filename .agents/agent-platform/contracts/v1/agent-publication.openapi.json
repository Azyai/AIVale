{
  "openapi": "3.1.0",
  "info": {
    "title": "AIVale Agent publication API",
    "version": "1.0.0",
    "description": "P02-T04 publishes immutable versions only. Version history, restore/activation, validation reports and execution are separate APIs."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local development example, not a deployed service"
    }
  ],
  "security": [
    {
      "DashboardSession": []
    }
  ],
  "paths": {
    "/api/agent-platform/workspaces/{workspace_id}/agents/{agent_id}/publish": {
      "post": {
        "operationId": "publishAgentVersion",
        "summary": "Publish an immutable Agent version",
        "description": "API-021. An explicit management session must currently have agent:publish on an active workspace. Strict JSON and no query parameters. New publication requires an active Agent and the exact saved draft_revision; current dependency or policy failures do not change the draft. No model is called. A scoped same-intent replay returns the original immutable receipt and expiry header without changing the current release pointer.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
              "maxLength": 19,
              "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
            },
            "description": "Authorized Team workspace ID."
          },
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
              "maxLength": 19,
              "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
            },
            "description": "Agent in the authorized workspace."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7E]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./agent-publication.schema.json#/$defs/publishRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable version receipt, including same-intent replay.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              },
              "Idempotency-Key-Expires-At": {
                "description": "Earliest expiry in UTC Unix milliseconds, represented by a decimal header value.",
                "schema": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,15}$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/publishResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or unsupported request",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Valid management session required",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current workspace does not permit editing",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Workspace or Agent is not available",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Safe internal failure",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Platform admission is disabled",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Draft revision changed, idempotency intent conflict, pending/disabled Agent, revoked receipt target or unsafe version state.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Current model or workspace policy does not permit this exact saved configuration.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Oneapi-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": "Server-owned ID equal to the JSON request_id."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent-publication.schema.json#/$defs/errorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DashboardSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Existing signed dashboard access JWT backed by a live login session. PAT and model bearer keys are not valid."
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aivale:agent-platform:agent-definition-reads:1.0.0",
  "title": "AIVale Agent definition metadata contract 1.0.0",
  "description": "P02-T03 read slice: API-015 and API-017 only. Management session and live workspace agent:read. No draft content or write operations.",
  "x-contract": {
    "version": "1.0.0",
    "task_id": "P02-T03",
    "core_version": "1.1.0",
    "api_ids": [
      "API-015",
      "API-017"
    ],
    "query": {
      "allowed": [
        "page",
        "page_size",
        "sort",
        "q",
        "status",
        "tag"
      ],
      "single_value": true,
      "q_match": "Trimmed, case-sensitive literal name substring; raw value at most 128 code points and 512 UTF-8 bytes.",
      "tag_match": "Trimmed, case-sensitive whole JSON tag value; raw value at most 64 code points and 256 UTF-8 bytes; empty rejected.",
      "detail_query": "none"
    },
    "archived": "Metadata is readable in a currently authorized workspace; archived or ungranted workspaces remain invisible."
  },
  "$defs": {
    "agentSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "maxLength": 19,
          "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00]*$"
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "single"
        },
        "status": {
          "enum": [
            "active",
            "disabled",
            "archived"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\x00]*$"
          }
        },
        "current_version_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
              "maxLength": 19,
              "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_permissions": {
          "const": [
            "agent:read"
          ]
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "created_at",
        "updated_at",
        "kind",
        "status",
        "tags",
        "current_version_id",
        "effective_permissions"
      ],
      "additionalProperties": false
    },
    "agentDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "maxLength": 19,
          "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00]*$"
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "single"
        },
        "status": {
          "enum": [
            "active",
            "disabled",
            "archived"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\x00]*$"
          }
        },
        "current_version_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
              "maxLength": 19,
              "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_permissions": {
          "const": [
            "agent:read"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\x00]*$",
          "description": "UTF-8 public description; server limit is 4096 encoded bytes."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "draft_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "created_at",
        "updated_at",
        "kind",
        "status",
        "tags",
        "current_version_id",
        "effective_permissions",
        "description",
        "revision",
        "draft_revision"
      ],
      "additionalProperties": false
    },
    "agentPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/agentSummary"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "items",
        "total",
        "page",
        "page_size"
      ],
      "additionalProperties": false
    },
    "listResponse": {
      "type": "object",
      "properties": {
        "success": {
          "const": true
        },
        "code": {
          "const": "OK"
        },
        "message": {
          "const": ""
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data": {
          "$ref": "#/$defs/agentPage"
        }
      },
      "required": [
        "success",
        "code",
        "message",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "detailResponse": {
      "type": "object",
      "properties": {
        "success": {
          "const": true
        },
        "code": {
          "const": "OK"
        },
        "message": {
          "const": ""
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data": {
          "$ref": "#/$defs/agentDetail"
        }
      },
      "required": [
        "success",
        "code",
        "message",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "errorResponse": {
      "$ref": "urn:aivale:agent-platform:core:1.1.0#/$defs/errorResponse"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/listResponse"
    },
    {
      "$ref": "#/$defs/detailResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}

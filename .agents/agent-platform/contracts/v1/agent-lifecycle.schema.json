  "$id": "urn:aivale:agent-platform:agent-lifecycle:1.0.0",
  "title": "AIVale Agent version history and lifecycle1.0.0",
  "x-contract": {
    "version": "1.0.0",
    "task_id": "P02-T05",
    "api_ids": [
      "API-022",
      "API-023",
      "API-024",
      "API-025",
      "API-026",
      "API-026A"
    ],
    "authorization": "Explicit live management session; no PAT or model tokens. Metadata agent:read; content/restore/status/archive agent:write; activation agent:publish. Content and writes need active workspace.",
    "history": "Release-only scoped COUNT and pagination; debug excluded. Archived Agent history remains readable under live workspace rights; archived workspaces are invisible. PublisherID is explicit version attribution.",
    "restore": "Exact verified snapshot to new draft, draft revision CAS. Retired model may be restored. No pointer/version change.",
    "activate": "Metadata revision CAS and exact version recheck against current model/workspace policy. Preserve draft/status.",
    "status": "Reversible active/disabled. Enabling current release rechecks policy. Same target state with correct revision is no-op. Archive terminal, retains history and fails closed until future runtime/schedule integration.",
    "concurrency": "No idempotency receipt or automatic POST retry for CAS commands. Unknown outcome: reread. Stale draft=AG_DRAFT_REVISION_CONFLICT, stale metadata=AG_INVALID_STATE; fixed error shape.",
    "audit": "Mutation and schema7 redacted audit same transaction. No prompts, raw reasons, notes, credentials in audit/SQL logs. No model execution, deletion or Run cancellation."
  },

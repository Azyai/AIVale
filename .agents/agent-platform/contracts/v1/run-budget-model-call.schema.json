{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aivale:agent-platform:run-budget-model-call:1.0.0",
  "title": "AIVale internal Run budget and model call correlation 1.0.0",
  "description": "Offline projections of internal readonly preparation and future trusted accounting DTOs. This does not define a public API or authorize dispatch, reservation, settlement or refund.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807.",
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "quota": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "not": {
        "pattern": "[^0-9]"
      },
      "description": "Canonical nonnegative signed-int64 quota string; this is a measurement domain, not a runtime allowance."
    },
    "singleCallQuota": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]{1}|214748364[0-6]|2147483647)$",
      "maxLength": 10,
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "positiveSingleCallQuota": {
      "allOf": [
        {
          "$ref": "#/$defs/singleCallQuota"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ]
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveAttempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "serverReference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{16,64}$",
      "minLength": 16,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_.:-]"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "[\u0000-\u001f-]"
      },
      "description": "At most 256 UTF-8 bytes with no surrounding whitespace or control characters; byte length is enforced by Go."
    },
    "commitState": {
      "enum": [

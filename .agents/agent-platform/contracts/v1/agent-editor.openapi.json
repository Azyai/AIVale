    "/api/agent-platform/workspaces/{workspace_id}/model-options": {
      "get": {
        "operationId": "listAgentEditorModelOptions",
        "summary": "List scoped model options",
        "description": "API-029. Editor-only current agent:write. Single page/page_size/q query values, q is case-sensitive literal substring; fixed byte-order model sorting. No funding_token_id or sort. Unavailable entries expose only a generic reason. Eligibility does not assert funding, runtime readiness or permanent permission.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
              "maxLength": 19,
              "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807."
            },
            "description": "Authorized Team workspace ID."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Raw maximum128 Unicode code points/512 UTF-8 bytes, then trimmed; literal case-sensitive substring."
          }
        ],

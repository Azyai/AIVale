{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aivale:agent-platform:run-journal-foundation:1.0.0",
  "title": "P03-T01 internal Run journal and notification foundation",
  "description": "Offline contract projections only. No HTTP admission, worker claim, model call or billing operation is enabled. JSON Schema cannot prove live references, source duplicate keys, byte sizes, hashes, authorization or lease freshness.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807.",
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[^a-f0-9]"
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stepKind": {
      "type": "string",
      "enum": [
        "model",
        "tool",
        "skill_load",
        "sandbox",
        "approval",
        "workflow_node"
      ]
    },
    "stepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "waiting_approval",
        "succeeded",
        "failed",
        "cancelled",
        "outcome_unknown",
        "skipped"
      ]
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[!-~]+$",
      "not": {
        "pattern": "[^!-~]"
      },
      "description": "Open visible-ASCII event vocabulary. Unknown event names do not authorize a lifecycle transition."
    },
    "notification": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "event_seq": {
          "$ref": "#/$defs/safeInteger"
        },
        "step_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "event_id",
        "event_seq"
      ],
      "additionalProperties": false
    },
    "pendingStepIntent": {
      "type": "object",
      "description": "Offline projection only; Go intent fields are json:\"-\". Objects map to internal JSON fields, and storage always creates pending/attempt=1. This schema is not an execution or deserialization API.",
      "properties": {
        "step_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/-]{0,95}$",
          "not": {
            "pattern": "[^a-z0-9._:/-]"
          }
        },
        "kind": {
          "$ref": "#/$defs/stepKind"
        },
        "parent_step_id": {
          "$ref": "#/$defs/id"
        },
        "input": {
          "type": "object"
        },
        "input_hash": {
          "$ref": "#/$defs/sha256"
        },
        "target_ref": {
          "type": "object"
        },
        "side_effect_policy": {
          "enum": [
            "read_only",
            "idempotent",
            "non_idempotent",
            "unknown"
          ],
          "default": "unknown"
        },
        "retry_policy": {
          "type": "object"
        }
      },
      "required": [
        "step_key",
        "kind",
        "target_ref",
        "retry_policy"
      ],
      "dependentRequired": {
        "input": [
          "input_hash"
        ],
        "input_hash": [
          "input"
        ]
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/notification"
    },
    {
      "$ref": "#/$defs/pendingStepIntent"
    }
  ]
}

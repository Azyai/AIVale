  "runtime_rejection_cases": [
    "metadata_only Run never becomes execution-admitted or receives a run notification",
    "cross-Team/workspace/Run/Event/Step references fail persisted checks",
    "same event key or logical step with different immutable intent conflicts",
    "old owner, old revision, expired lease or superseded claim cannot acknowledge or retry",
    "same notification key upsert is rejected; dead replay preserves its key",
    "rollback leaves no step/event/notification or Run sequence advance",
    "malformed UTF-8, duplicate decoded JSON keys, malformed Unicode and source byte overflow fail strict production codecs"
  ],
  "schema_limits": "JSON Schema checks shape only, not source duplicate keys, 16KiB notification bytes, 60KiB step JSON bytes, input hash equality, actual references, lease time or admission."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aivale:agent-platform:run-ledger-foundation:1.0.0",
  "title": "P03-T02 internal reservation and model-call ledger foundation",
  "description": "Offline projections only. No HTTP endpoint, service credential, production admission, model dispatch, receipt projection, wallet charge or refund is enabled. Source freshness, authorization, UTF-8 bytes, arithmetic and cross-object references require production checks.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "description": "Canonical positive signed-int64 decimal string, maximum 9223372036854775807.",
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "singleCallQuota": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]{1}|214748364[0-6]|2147483647)$",
      "maxLength": 10,
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[^a-f0-9]"
      }
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "callReference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{15,63}$",
      "not": {
        "pattern": "[^a-z0-9._:-]"
      },
      "description": "New internal producer references are lowercase ASCII; legacy HTTP trace IDs are separate."
    },
    "leaseOwner": {
      "type": "string",
      "pattern": "^[!-~]{1,96}$",
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "team_id": {
          "$ref": "#/$defs/id"
        },
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "step_id": {
          "$ref": "#/$defs/id"
        },
        "agent_id": {
          "$ref": "#/$defs/id"
        },
        "agent_version_id": {
          "$ref": "#/$defs/id"
        },
        "execution_user_id": {
          "$ref": "#/$defs/id"
        },
        "funding_token_id": {
          "$ref": "#/$defs/id"
        },
        "caller_token_id": {
          "const": null
        },
        "logical_call_id": {
          "$ref": "#/$defs/callReference"
        },
        "attempt": {
          "const": 1
        },
        "lease_epoch": {
          "$ref": "#/$defs/safeInteger"
        },
        "gateway_request_id": {
          "$ref": "#/$defs/callReference"
        },
        "request_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "team_id",
        "workspace_id",
        "run_id",
        "step_id",
        "agent_id",
        "agent_version_id",
        "execution_user_id",
        "funding_token_id",
        "caller_token_id",
        "logical_call_id",
        "attempt",
        "lease_epoch",
        "gateway_request_id",
        "request_hash"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_cost_quota": {
          "allOf": [
            {
              "$ref": "#/$defs/singleCallQuota"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        },
        "max_model_calls": {
          "const": 1
        },
        "max_tool_calls": {
          "const": 0
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741823
        },
        "execution_budget_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "required": [
        "max_cost_quota",
        "max_model_calls",
        "max_tool_calls",
        "max_steps",
        "max_output_tokens",
        "execution_budget_ms"
      ],
      "additionalProperties": false
    },
    "reservationIntent": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "lease_owner": {
          "$ref": "#/$defs/leaseOwner"
        },
        "expected_run_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740990
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "config_hash": {
          "$ref": "#/$defs/sha256"
        },
        "pricing_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "upper_bound_quota": {
          "$ref": "#/$defs/singleCallQuota"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741823
        },
        "execution_budget_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "quote_expires_at": {
          "$ref": "#/$defs/safeInteger"
        },
        "valid_until": {
          "$ref": "#/$defs/safeInteger"
        },
        "event_key": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "identity",
        "lease_owner",
        "expected_run_revision",
        "model_name",
        "config_hash",
        "pricing_snapshot_hash",
        "limits",
        "upper_bound_quota",
        "max_output_tokens",
        "execution_budget_ms",
        "quote_expires_at",
        "valid_until",
        "event_key"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "lease_owner": {
          "$ref": "#/$defs/leaseOwner"
        },
        "event_key": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "identity",
        "lease_owner",
        "event_key"
      ],
      "additionalProperties": false
    },
    "preparedGateway": {
      "type": "object",
      "properties": {
        "gateway_call_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "step_id": {
          "$ref": "#/$defs/id"
        },
        "logical_call_id": {
          "$ref": "#/$defs/callReference"
        },
        "attempt": {
          "const": 1
        },
        "gateway_request_id": {
          "$ref": "#/$defs/callReference"
        },
        "funding_token_id": {
          "$ref": "#/$defs/id"
        },
        "lease_epoch": {
          "$ref": "#/$defs/safeInteger"
        },
        "request_hash": {
          "$ref": "#/$defs/sha256"
        },
        "state": {
          "const": "prepared"
        },
        "funding_state": {
          "const": "pending"
        },
        "token_state": {
          "const": "pending"
        },
        "actual_quota": {
          "const": null
        },
        "preconsume_quota": {
          "const": null
        },
        "consume_log_id": {
          "const": null
        }
      },
      "required": [
        "gateway_call_id",
        "run_id",
        "step_id",
        "logical_call_id",
        "attempt",
        "gateway_request_id",
        "funding_token_id",
        "lease_epoch",
        "request_hash",
        "state",
        "funding_state",
        "token_state",
        "actual_quota",
        "preconsume_quota",
        "consume_log_id"
      ],
      "additionalProperties": false
    },
    "unknownResult": {
      "type": "object",
      "properties": {
        "gateway_state": {
          "const": "outcome_unknown"
        },
        "reservation_status": {
          "const": "outcome_unknown"
        },
        "step_status": {
          "const": "outcome_unknown"
        },
        "run_status": {
          "const": "failed"
        },
        "error_code": {
          "const": "CALL_OUTCOME_UNKNOWN"
        },
        "usage_state": {
          "const": "reconciliation_required"
        },
        "requires_reconcile": {
          "const": 1
        },
        "estimated_quota": {
          "$ref": "#/$defs/singleCallQuota"
        },
        "budget_reserved_quota": {
          "$ref": "#/$defs/singleCallQuota"
        },
        "settled_quota": {
          "const": null
        },
        "actual_quota": {
          "const": null
        },
        "consume_log_id": {
          "const": null
        }
      },
      "required": [
        "gateway_state",
        "reservation_status",
        "step_status",
        "run_status",
        "error_code",
        "usage_state",
        "requires_reconcile",
        "estimated_quota",
        "budget_reserved_quota",
        "settled_quota",
        "actual_quota",
        "consume_log_id"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/reservationIntent"
    },
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/preparedGateway"
    },
    {
      "$ref": "#/$defs/unknownResult"
    }
  ]
}
